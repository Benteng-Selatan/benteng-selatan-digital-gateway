# Database Neon (pooled untuk runtime, direct/unpooled untuk Drizzle)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-POOLER/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# CMS petugas. Secret sesi minimal 32 karakter.
CMS_USERNAME=admin
CMS_PASSWORD=CHANGE_ME
CMS_SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# Portal warga. Gunakan secret terpisah minimal 32 karakter.
CITIZEN_SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET
CITIZEN_DATA_ENCRYPTION_KEY=GENERATE_A_LONG_RANDOM_SECRET

# Vercel Blob untuk media publik CMS dan kontribusi publik warga
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
