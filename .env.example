# Identitas environment. Nilai aplikasi dan target database wajib sama.
APP_ENV=development
DATABASE_TARGET_ENV=development

# Neon PostgreSQL (jangan commit nilai asli).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-POOLER/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Hanya hostname, boleh lebih dari satu dipisahkan koma.
DATABASE_ALLOWED_HOSTS=ep-example-development.ap-southeast-1.aws.neon.tech

# Bootstrap Super Admin (hanya saat tabel staff_users masih kosong).
CMS_USERNAME=admin
CMS_PASSWORD=CHANGE_ME_WITH_AT_LEAST_12_CHARACTERS
CMS_SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# Portal warga.
CITIZEN_SESSION_SECRET=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET
# Wajib khusus dan minimal 32 karakter. Jangan samakan dengan session secret.
CITIZEN_DATA_ENCRYPTION_KEY=GENERATE_A_DEDICATED_32_PLUS_CHARACTER_KEY
# Isi hanya ketika membaca ciphertext lama yang dibuat dengan kunci sebelumnya.
CITIZEN_DATA_LEGACY_ENCRYPTION_KEY=

# Vercel Blob publik untuk media CMS dan berkas yang sudah disetujui.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_public_store_token
# Vercel Blob PRIVATE terpisah untuk unggahan warga sebelum moderasi.
CITIZEN_BLOB_READ_WRITE_TOKEN=vercel_blob_rw_private_store_token

# Allowlist URL yang dapat disimpan CMS. Pisahkan hostname dengan koma.
CMS_ALLOWED_BESTI_HOSTS=
CMS_ALLOWED_SOCIAL_HOSTS=
CMS_ALLOWED_MAP_HOSTS=
CMS_ALLOWED_MARKETPLACE_HOSTS=
CMS_ALLOWED_EXTERNAL_HOSTS=
CMS_ALLOWED_IMAGE_HOSTS=

# Hanya untuk migrasi Production yang sudah memiliki backup valid.
ALLOW_PRODUCTION_MIGRATION=

# Housekeeping unggahan privat. Default script adalah dry-run.
PENDING_UPLOAD_RETENTION_DAYS=7
CONFIRM_DELETE_PENDING_UPLOADS=
