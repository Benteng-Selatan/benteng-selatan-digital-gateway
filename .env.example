# Database Neon (pooled untuk runtime, direct/unpooled untuk Drizzle)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# CMS petugas
CMS_USERNAME=admin
CMS_PASSWORD="change-this-password"
CMS_SESSION_SECRET="generate-random-secret"

# Portal warga. Jika kosong, CMS_SESSION_SECRET dipakai sebagai fallback.
CITIZEN_SESSION_SECRET="generate-different-random-secret"
CITIZEN_DATA_ENCRYPTION_KEY="replace-with-your-own-32-plus-character-key"

# Vercel Blob untuk media publik CMS dan kontribusi publik warga
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token"
